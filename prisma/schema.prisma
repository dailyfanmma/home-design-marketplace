generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  HOMEOWNER
  DESIGNER
  ADMIN
}

enum RoomType {
  KITCHEN
  BATHROOM
  LIVING_ROOM
  BEDROOM
  OUTDOOR
  OTHER
}

enum ContestStatus {
  OPEN
  AWARDED
  CLOSED
}

enum BookingStatus {
  PENDING
  PAID
  COMPLETED
}

enum EventKind {
  DAILY
  THEMED
}

enum EventStatus {
  UPCOMING
  ACTIVE
  CLOSED
}

enum CreditTxType {
  SIGNUP_BONUS
  PURCHASE
  VOTE_SPEND
  POST_SPEND
  REVIEW_SPEND
  EVENT_ENTRY_SPEND
  GENERATE_CONCEPT_SPEND
  REFERRAL_SIGNUP_BONUS
  REFERRAL_PURCHASE_BONUS
}

enum NotificationType {
  NEW_ENTRY
  NEW_VOTE
  CONTEST_CLOSED
  ENTRY_AWARDED
  REFERRAL_SIGNUP
  REFERRAL_PURCHASE
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      Role
  bio       String?
  avatarUrl String?
  credits   Int      @default(10)
  /// True for seeded AI-persona designers used to bootstrap contest supply.
  /// Always disclosed in the UI, and never eligible to be hired -- see
  /// awardWinner in lib/actions.ts.
  isAiGenerated Boolean @default(false)
  createdAt DateTime @default(now())

  /// Who referred this user, if anyone. A user's own referral link is just
  /// /signup?ref=<their id> -- no separate code needed. See referrals below.
  referredById String?
  referredBy   User?   @relation("Referrals", fields: [referredById], references: [id])
  referrals    User[]  @relation("Referrals")

  submissions Submission[] @relation("HomeownerSubmissions")
  entries     Entry[]
  votes       Vote[]
  showcaseItems ShowcaseItem[]
  creditTransactions CreditTransaction[]
  notifications Notification[]

  reviewsAuthored Review[] @relation("ReviewAuthor")
  reviewsReceived Review[] @relation("ReviewTarget")

  bookingsAsDesigner  Booking[] @relation("DesignerBookings")
  bookingsAsHomeowner Booking[] @relation("HomeownerBookings")
}

/// A time-boxed contest cycle -- the daily contest, or a themed event like
/// "Rainbow Week" or "Greenery Challenge". Submissions can optionally enter one.
model Event {
  id        String      @id @default(cuid())
  title     String
  theme     String?
  kind      EventKind
  entryCost Int         @default(0)
  opensAt   DateTime
  closesAt  DateTime
  status    EventStatus @default(UPCOMING)
  createdAt DateTime    @default(now())

  submissions Submission[]
}

model CreditTransaction {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  amount    Int
  type      CreditTxType
  note      String?
  createdAt DateTime     @default(now())
}

/// A designer's real past work, shown on their profile alongside contest entries.
model ShowcaseItem {
  id          String   @id @default(cuid())
  designerId  String
  designer    User     @relation(fields: [designerId], references: [id])
  title       String
  imageUrl    String
  description String
  externalUrl String?
  createdAt   DateTime @default(now())
}

model Submission {
  id          String        @id @default(cuid())
  homeownerId String
  homeowner   User          @relation("HomeownerSubmissions", fields: [homeownerId], references: [id])
  eventId     String?
  event       Event?        @relation(fields: [eventId], references: [id])
  title       String
  roomType    RoomType
  description String
  budget      Int?
  photoUrl    String
  status      ContestStatus @default(OPEN)
  /// When this contest stops accepting new entries/votes. Inherited from the
  /// Event if entered into one, otherwise defaults to 7 days out (see
  /// createSubmission in lib/actions.ts). Enforced lazily by
  /// lib/lifecycle.ts's syncLifecycle -- there's no real cron job, so it
  /// flips OPEN -> CLOSED on read, at the top of every page/action that
  /// touches contest state. The homeowner can still award a winner from a
  /// CLOSED contest (judging happens after submissions close); only AWARDED
  /// is truly terminal.
  closesAt    DateTime
  createdAt   DateTime      @default(now())

  entries    Entry[]
  booking    Booking?
  aiConcepts AiConcept[]
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  message   String
  linkPath  String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
}

/// A stubbed instant AI concept generated by the homeowner themselves for
/// their own submission -- see generateConcept in lib/actions.ts. Private to
/// the homeowner (not shown in the public entries grid): it doesn't compete
/// for votes against real designer entries, it's just a starting-point
/// preview. Always disclosed as AI-generated wherever it's shown.
model AiConcept {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id])
  style        String
  imageUrl     String
  description  String
  createdAt    DateTime   @default(now())
}

model Entry {
  id           String   @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id])
  designerId   String
  designer     User     @relation(fields: [designerId], references: [id])
  imageUrl     String
  description  String
  createdAt    DateTime @default(now())

  productLinks ProductLink[]
  votes        Vote[]
  booking      Booking?
}

model ProductLink {
  id       String  @id @default(cuid())
  entryId  String
  entry    Entry   @relation(fields: [entryId], references: [id])
  label    String
  url      String
  price    Float?
  retailer String?
}

model Vote {
  id        String   @id @default(cuid())
  entryId   String
  entry     Entry    @relation(fields: [entryId], references: [id])
  voterId   String
  voter     User     @relation(fields: [voterId], references: [id])
  createdAt DateTime @default(now())

  @@unique([entryId, voterId])
}

model Booking {
  id           String        @id @default(cuid())
  submissionId String        @unique
  submission   Submission    @relation(fields: [submissionId], references: [id])
  entryId      String        @unique
  entry        Entry         @relation(fields: [entryId], references: [id])
  designerId   String
  designer     User          @relation("DesignerBookings", fields: [designerId], references: [id])
  homeownerId  String
  homeowner    User          @relation("HomeownerBookings", fields: [homeownerId], references: [id])
  designFee    Int
  platformFee  Int
  totalCharge  Int
  status       BookingStatus @default(PENDING)
  createdAt    DateTime      @default(now())

  review Review?
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  authorId  String
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetId  String
  target    User     @relation("ReviewTarget", fields: [targetId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

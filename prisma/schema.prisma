generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  HOMEOWNER
  DESIGNER
  ADMIN
}

enum RoomType {
  KITCHEN
  BATHROOM
  LIVING_ROOM
  BEDROOM
  OUTDOOR
  OTHER
}

enum ContestStatus {
  OPEN
  AWARDED
  CLOSED
}

enum BookingStatus {
  PENDING
  PAID
  COMPLETED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      Role
  bio       String?
  avatarUrl String?
  createdAt DateTime @default(now())

  submissions Submission[] @relation("HomeownerSubmissions")
  entries     Entry[]
  votes       Vote[]

  reviewsAuthored Review[] @relation("ReviewAuthor")
  reviewsReceived Review[] @relation("ReviewTarget")

  bookingsAsDesigner  Booking[] @relation("DesignerBookings")
  bookingsAsHomeowner Booking[] @relation("HomeownerBookings")
}

model Submission {
  id          String        @id @default(cuid())
  homeownerId String
  homeowner   User          @relation("HomeownerSubmissions", fields: [homeownerId], references: [id])
  title       String
  roomType    RoomType
  description String
  budget      Int?
  photoUrl    String
  status      ContestStatus @default(OPEN)
  createdAt   DateTime      @default(now())

  entries Entry[]
  booking Booking?
}

model Entry {
  id           String   @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id])
  designerId   String
  designer     User     @relation(fields: [designerId], references: [id])
  imageUrl     String
  description  String
  createdAt    DateTime @default(now())

  productLinks ProductLink[]
  votes        Vote[]
  booking      Booking?
}

model ProductLink {
  id       String  @id @default(cuid())
  entryId  String
  entry    Entry   @relation(fields: [entryId], references: [id])
  label    String
  url      String
  price    Float?
  retailer String?
}

model Vote {
  id        String   @id @default(cuid())
  entryId   String
  entry     Entry    @relation(fields: [entryId], references: [id])
  voterId   String
  voter     User     @relation(fields: [voterId], references: [id])
  createdAt DateTime @default(now())

  @@unique([entryId, voterId])
}

model Booking {
  id           String        @id @default(cuid())
  submissionId String        @unique
  submission   Submission    @relation(fields: [submissionId], references: [id])
  entryId      String        @unique
  entry        Entry         @relation(fields: [entryId], references: [id])
  designerId   String
  designer     User          @relation("DesignerBookings", fields: [designerId], references: [id])
  homeownerId  String
  homeowner    User          @relation("HomeownerBookings", fields: [homeownerId], references: [id])
  designFee    Int
  platformFee  Int
  totalCharge  Int
  status       BookingStatus @default(PENDING)
  createdAt    DateTime      @default(now())

  review Review?
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  authorId  String
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetId  String
  target    User     @relation("ReviewTarget", fields: [targetId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

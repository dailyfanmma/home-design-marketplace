generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  HOMEOWNER
  DESIGNER
  ADMIN
}

enum RoomType {
  KITCHEN
  BATHROOM
  LIVING_ROOM
  BEDROOM
  OUTDOOR
  HOME_OFFICE
  ENTRYWAY
  OTHER
}

enum ContestStatus {
  OPEN
  AWARDED
  CLOSED
}

enum BookingStatus {
  PENDING
  PAID
  COMPLETED
}

enum EventKind {
  DAILY
  WEEKLY
  THEMED
}

enum EventStatus {
  UPCOMING
  ACTIVE
  CLOSED
}

enum CreditTxType {
  SIGNUP_BONUS
  PURCHASE
  VOTE_SPEND
  POST_SPEND
  REVIEW_SPEND
  EVENT_ENTRY_SPEND
  GENERATE_CONCEPT_SPEND
  COMMISSION_SPEND
  REFERRAL_SIGNUP_BONUS
  REFERRAL_PURCHASE_BONUS
  DAILY_LOGIN_BONUS
  FLAIR_PURCHASE
}

enum NotificationType {
  NEW_ENTRY
  NEW_VOTE
  CONTEST_CLOSED
  ENTRY_AWARDED
  REFERRAL_SIGNUP
  REFERRAL_PURCHASE
  DAILY_LOGIN_BONUS
  ACHIEVEMENT_UNLOCKED
  CONTEST_WON
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      Role
  bio       String?
  avatarUrl String?
  credits   Int      @default(10)
  /// True for seeded AI-persona designers used to bootstrap contest supply.
  /// Always disclosed in the UI, and never eligible to be hired -- see
  /// awardWinner in lib/actions.ts.
  isAiGenerated Boolean @default(false)
  /// Which entry in lib/personas.ts's catalog this AI-persona account is.
  /// The single source of truth for that persona's style/signature, used
  /// both for their seeded contest entries and for paid commissions (see
  /// lib/personaCommission.ts) so the same persona never drifts style.
  personaKey String?
  /// The single house account that owns system-generated daily/weekly
  /// contests (see lib/contestGenerator.ts). Not shown as a "real" homeowner
  /// in any UI that implies a real person is waiting on a hire.
  isSystemAccount Boolean @default(false)
  createdAt DateTime @default(now())

  /// Daily login reward state -- see lib/loginRewards.ts. Claimed lazily
  /// (no real cron): checked once per page load in the root layout.
  loginStreak       Int       @default(0)
  lastLoginRewardAt DateTime?

  /// The profile flair currently displayed next to this user's name, if any.
  /// Owned flairs are tracked in UserFlair; this just points at the
  /// currently-equipped one. See lib/flair.ts.
  equippedFlairKey String?

  /// Who referred this user, if anyone. A user's own referral link is just
  /// /signup?ref=<their id> -- no separate code needed. See referrals below.
  referredById String?
  referredBy   User?   @relation("Referrals", fields: [referredById], references: [id])
  referrals    User[]  @relation("Referrals")

  submissions Submission[] @relation("HomeownerSubmissions")
  entries     Entry[]
  votes       Vote[]
  showcaseItems ShowcaseItem[]
  creditTransactions CreditTransaction[]
  notifications Notification[]
  achievements UserAchievement[]
  flairs       UserFlair[]
  commissionsBought    Commission[] @relation("CommissionBuyer")
  commissionsFulfilled Commission[] @relation("CommissionedPersona")

  reviewsAuthored Review[] @relation("ReviewAuthor")
  reviewsReceived Review[] @relation("ReviewTarget")

  bookingsAsDesigner  Booking[] @relation("DesignerBookings")
  bookingsAsHomeowner Booking[] @relation("HomeownerBookings")
}

/// A time-boxed contest cycle -- the daily contest, or a themed event like
/// "Rainbow Week" or "Greenery Challenge". Submissions can optionally enter one.
model Event {
  id        String      @id @default(cuid())
  title     String
  theme     String?
  kind      EventKind
  entryCost Int         @default(0)
  opensAt   DateTime
  closesAt  DateTime
  status    EventStatus @default(UPCOMING)
  createdAt DateTime    @default(now())

  submissions Submission[]
}

model CreditTransaction {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  amount    Int
  type      CreditTxType
  note      String?
  createdAt DateTime     @default(now())
}

/// A designer's real past work, shown on their profile alongside contest entries.
model ShowcaseItem {
  id          String   @id @default(cuid())
  designerId  String
  designer    User     @relation(fields: [designerId], references: [id])
  title       String
  imageUrl    String
  description String
  externalUrl String?
  createdAt   DateTime @default(now())
}

model Submission {
  id          String        @id @default(cuid())
  homeownerId String
  homeowner   User          @relation("HomeownerSubmissions", fields: [homeownerId], references: [id])
  eventId     String?
  event       Event?        @relation(fields: [eventId], references: [id])
  title       String
  roomType    RoomType
  description String
  budget      Int?
  photoUrl    String
  status      ContestStatus @default(OPEN)
  /// When this contest stops accepting new entries/votes. Inherited from the
  /// Event if entered into one, otherwise defaults to 7 days out (see
  /// createSubmission in lib/actions.ts). Enforced lazily by
  /// lib/lifecycle.ts's syncLifecycle -- there's no real cron job, so it
  /// flips OPEN -> CLOSED on read, at the top of every page/action that
  /// touches contest state. The homeowner can still award a winner from a
  /// CLOSED contest (judging happens after submissions close); only AWARDED
  /// is truly terminal.
  closesAt    DateTime
  /// True for a room posted by the system house account rather than a real
  /// homeowner -- see lib/contestGenerator.ts. These can never be awarded
  /// (there's no real person to pay or to deliver work), but voting still
  /// crowns a top entry for bragging rights + an achievement when it closes.
  isSystemGenerated Boolean @default(false)
  createdAt   DateTime      @default(now())

  entries     Entry[]
  booking     Booking?
  aiConcepts  AiConcept[]
  commissions Commission[]
}

/// Static catalog lives in lib/achievements.ts; this just records who has
/// unlocked what, and when.
model UserAchievement {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  achievementKey String
  unlockedAt     DateTime @default(now())

  @@unique([userId, achievementKey])
}

/// Static catalog lives in lib/flair.ts. Owning a flair (buying it with
/// credits, or earning it via an achievement) is separate from having it
/// equipped -- see User.equippedFlairKey.
model UserFlair {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  flairKey   String
  unlockedAt DateTime @default(now())

  @@unique([userId, flairKey])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  message   String
  linkPath  String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
}

/// A stubbed instant AI concept generated by the homeowner themselves for
/// their own submission -- see generateConcept in lib/actions.ts. Private to
/// the homeowner (not shown in the public entries grid): it doesn't compete
/// for votes against real designer entries, it's just a starting-point
/// preview. Always disclosed as AI-generated wherever it's shown.
model AiConcept {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id])
  style        String
  imageUrl     String
  description  String
  createdAt    DateTime   @default(now())
}

/// A paid, private request for a specific AI persona to generate a few
/// concepts (with product links) in their fixed style -- see
/// lib/personaCommission.ts. Unlike AiConcept this costs more and includes
/// shoppable links, but like AiConcept it's private to the buyer and never a
/// public contest entry: see Entry.commissionId.
model Commission {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id])
  personaId    String
  persona      User       @relation("CommissionedPersona", fields: [personaId], references: [id])
  buyerId      String
  buyer        User       @relation("CommissionBuyer", fields: [buyerId], references: [id])
  cost         Int
  createdAt    DateTime   @default(now())

  entries Entry[]
}

model Entry {
  id           String   @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id])
  designerId   String
  designer     User     @relation(fields: [designerId], references: [id])
  imageUrl     String
  description  String
  createdAt    DateTime @default(now())

  /// Set only for a concept generated by a paid Commission -- private to the
  /// buyer, excluded from the public entries grid, and never votable or
  /// awardable. Null for a normal contest entry.
  commissionId String?
  commission   Commission? @relation(fields: [commissionId], references: [id])

  productLinks ProductLink[]
  votes        Vote[]
  booking      Booking?
}

model ProductLink {
  id       String  @id @default(cuid())
  entryId  String
  entry    Entry   @relation(fields: [entryId], references: [id])
  label    String
  url      String
  price    Float?
  retailer String?
}

model Vote {
  id        String   @id @default(cuid())
  entryId   String
  entry     Entry    @relation(fields: [entryId], references: [id])
  voterId   String
  voter     User     @relation(fields: [voterId], references: [id])
  createdAt DateTime @default(now())

  @@unique([entryId, voterId])
}

model Booking {
  id           String        @id @default(cuid())
  submissionId String        @unique
  submission   Submission    @relation(fields: [submissionId], references: [id])
  entryId      String        @unique
  entry        Entry         @relation(fields: [entryId], references: [id])
  designerId   String
  designer     User          @relation("DesignerBookings", fields: [designerId], references: [id])
  homeownerId  String
  homeowner    User          @relation("HomeownerBookings", fields: [homeownerId], references: [id])
  designFee    Int
  platformFee  Int
  totalCharge  Int
  status       BookingStatus @default(PENDING)
  createdAt    DateTime      @default(now())

  review Review?
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  authorId  String
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetId  String
  target    User     @relation("ReviewTarget", fields: [targetId], references: [id])
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}
